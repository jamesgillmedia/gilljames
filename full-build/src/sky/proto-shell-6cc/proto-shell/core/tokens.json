        "w": 10,
        "use": "m4 scroll spring",
        "source": "sky.js"
      },
      "instant": {
        "w": 40,
        "use": "m4 aim instant",
        "source": "sky.js"
      },
      "tiltBlend": {
        "w": 9,
        "settleCommentSec": 0.6,
        "use": "4:45 look-around tilt",
        "source": "blend.js"
      }
    },
    "flingDecayPerSec": 4.5,
    "motionAfterglowPerSec": 2.2,
    "durationsMs": {
      "glideDefault": 950,
      "glideHomeChapterWork": 1000,
      "openFilmBoard": 700,
      "rubberBandBelowField": 500,
      "doubleTapStepOut": 800,
