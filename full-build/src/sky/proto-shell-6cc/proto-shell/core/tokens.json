  "motion": {
    "reduceMotionIdentical": true,
    "reduceMotionNote": "4:31 sky and 4:45 blend do not read prefers-reduced-motion. Do not copy preview-film-snap RM branches.",
    "easing": {
      "easeInOutCubic": {
        "fn": "u < 0.5 ? 4*u*u*u : 1 - pow(-2*u+2, 3)/2",
        "usedFor": [
          "glide",
          "m4 ease()"
        ],
        "source": "blend.js stepGlide; fable-m4/js/sky.js ease"
      },
      "smoothstep": {
        "fn": "u*u*(3-2*u)",
        "source": "blend.js sstep (two-edge form)"
      },
      "stillFraming": {
        "css": "cubic-bezier(.22, .7, .2, 1)",
        "durationMs": 900,
        "source": "fable-m4/js/depth.js FRAME_EASE"
      }
    },
    "springs": {
      "integrator": "k=exp(-w*dt); c=v+w*e; x=target+(e+c*dt)*k; v=(v-w*c*dt)*k",
      "kind": "critical-damping",
      "W_GLIDE": {
        "w": 4.8,
        "use": "m4 camera / board",
        "source": "sky.js"
      },
