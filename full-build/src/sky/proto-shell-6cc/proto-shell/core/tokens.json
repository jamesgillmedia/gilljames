      "bokehLife": 900,
      "framedStill": 900,
      "stillSpringBack": 300,
      "stillSpringBackAlt": 250,
      "stillOpacity": 260,
      "waterRipple": 1500,
      "waterRippleRemove": 1600,
      "openingCardGlide": 520,
      "openingPinchInterrupt": 280,
      "openingWheelTimeout": 180,
      "markDrawTimesOpen": 1100,
      "markDimTimesOpen": 600,
      "flyTimesFade": 1680,
      "arriveDelayTimesDelay": 1250,
      "skyIntroTimesOpen": 450,
      "skyIntroFadeStartTimesOpen": 1350,
      "skyIntroFadeTimesFade": 1300
    },
    "depthOvershoot": {
      "source": "fable-m4/js/depth.js viewScale",
      "durationMs": 960,
      "firstPhase": {
        "progressEnd": 0.38,
        "raw": "1 + 1.2 * (1 - pow(1-k, 2))",
        "peakScale": 2.2
      },
      "secondPhase": {
        "progressStart": 0.38,
        "raw": "1.1 - 0.1 * (1 - pow(1-k2, 3))",
        "startScale": 1.1,
        "endScale": 1.0
      }
    },
    "wheelZoom": {
      "source": "constellation-blend/blend.js",
      "formula": "k = exp(-deltaY * (ctrlKey ? 0.012 : 0.0016)); zoomAt(x, y, cam.s * k)",
      "ctrlKeyGain": 0.012,
      "plainGain": 0.0016,
      "settleDelayMs": 260,
      "note": "4:31 m4 sky has no general wheel zoom."
    },
    "doubleTap": {
      "blend": {
        "windowMs": 320,
        "distancePx": 30,
        "scaleDivisor": 3.2,
        "durationMs": 800,
        "source": "blend.js"
